// enact-probe on a macOS agent labelled 'xcode'. Stages call the same scripts as GitHub Actions.
pipeline {
  agent { label 'xcode' }
  options { timestamps(); timeout(time: 60, unit: 'MINUTES') }
  stages {
    stage('Toolchain') { steps { dir('enact-probe') { sh 'sw_vers && xcodebuild -version && swift --version' } } }
    stage('XCTest + protocol + fault matrix') {
      steps { dir('enact-probe') { sh 'scripts/ci/unit.sh' } }
      post { always { junit allowEmptyResults: true, testResults: 'enact-probe/build/reports/pytest.xml' } }
    }
    stage('XCUITest (iPhone)') {
      // One simulator session at a time per agent: the servers bind fixed ports 8770/8771.
      steps { lock('enact-ports') { dir('enact-probe') { sh 'scripts/ci/ui.sh' } } }
    }
  }
  post { always { archiveArtifacts allowEmptyArchive: true, artifacts: 'enact-probe/build/reports/**' } }
}
